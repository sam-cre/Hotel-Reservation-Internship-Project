# Backend configuration only. Never prefix secrets with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=0
WEATHER_TIMEOUT_MS=4000
WEATHER_CACHE_TTL_MS=600000

# PostgreSQL. Keep real credentials only in an ignored .env file or cloud secret store.
DATABASE_URL=postgresql://localhost:5432/stillwater_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
# The test command requires a test_ prefix or _test suffix in the database name.
TEST_DATABASE_URL=postgresql://localhost:5432/stillwater_test

# Authentication. Generate a unique secret with at least 32 characters.
JWT_SECRET=
JWT_ISSUER=stillwater-api
JWT_AUDIENCE=stillwater-web
JWT_TTL_MINUTES=30
AUTH_COOKIE_NAME=stillwater_session
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Used only by the explicit administrator provisioning command.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
