# Backend configuration only. Never prefix secrets with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# PostgreSQL. Keep real credentials only in an ignored .env file or cloud secret store.
DATABASE_URL=postgresql://localhost:5432/stillwater_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
# The test command requires a test_ prefix or _test suffix in the database name.
TEST_DATABASE_URL=postgresql://localhost:5432/stillwater_test

# Used only by the explicit administrator provisioning command.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
