{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "vitest run",
    "test:database": "vitest run test/database",
    "db:migrate": "node --env-file-if-exists=../.env src/db/run-migrations.js",
    "db:seed": "node --env-file-if-exists=../.env src/db/run-development-seed.js",
    "db:provision-admin": "node --env-file-if-exists=../.env src/db/run-provision-admin.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "supertest": "7.2.2",
    "vitest": "5.0.0"
  }
}
